<Window x:Class="LockAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowState="Maximized"
        Title="LockAgent" Background="#0D1627">

    <Grid>
        <Grid Background="#A0000000"/>

        <!-- Часы/дата внизу слева -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="56,0,0,56">
            <TextBlock x:Name="ClockTime" FontFamily="Segoe UI Light" FontSize="88" FontWeight="Light"
                       Foreground="White" Text="&#x2014;&#x2014;:&#x2014;&#x2014;"/>
            <TextBlock x:Name="ClockDate" FontFamily="Segoe UI" FontSize="24" FontWeight="Light"
                       Foreground="#E6FFFFFF" Margin="6,4,0,0" Text=""/>
        </StackPanel>

        <!-- Индикатор раскладки внизу справа: всегда ENG -->
        <TextBlock x:Name="KbdLayout" Text="ENG" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,56,56" FontSize="12" Foreground="#E6FFFFFF"/>

        <!-- Центр: замок -->
        <StackPanel x:Name="LoginPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="80" Height="80" CornerRadius="40" Background="#335A819A"
                    HorizontalAlignment="Center" BorderBrush="#66FFFFFF" BorderThickness="1">
                <TextBlock x:Name="AvatarLetter" FontFamily="Segoe UI" FontSize="38"
                           Foreground="White" Text="U" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="UserNameLabel" HorizontalAlignment="Center" Margin="0,14,0,0"
                       FontFamily="Segoe UI" FontSize="30" FontWeight="Light" Foreground="White"/>
            <TextBlock Text="Desktop is locked. Enter your password." HorizontalAlignment="Center"
                       Margin="0,8,0,0" FontSize="15" Foreground="#BFCBDC"/>

            <Border Background="#22000000" CornerRadius="3" BorderBrush="#55FFFFFF"
                    BorderThickness="1" Margin="0,22,0,0" Width="360" Height="30">
                <Grid>
                    <TextBox x:Name="PasswordBox" PreviewTextInput="PasswordBox_PreviewTextInput"
                             PreviewKeyDown="PasswordBox_PreviewKeyDown" Padding="10,0,44,0"
                             VerticalContentAlignment="Center" FontSize="16" Background="Transparent"
                             Foreground="White" BorderThickness="0" CaretBrush="White"/>
                    <Button x:Name="ShowPasswordBtn" Content="&#x1F441;" Width="24" Height="24"
                            HorizontalAlignment="Right" Margin="0,0,4,0" Background="Transparent"
                            BorderThickness="0" Foreground="#CCFFFFFF" FontSize="13" Cursor="Hand"
                            Click="ShowPasswordBtn_Click"/>
                </Grid>
            </Border>

<Button x:Name="EnterBtn" Content="Sign in" Click="EnterBtn_Click" HorizontalAlignment="Center" Margin="0,18,0,0"
                    Width="180" Height="44" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"
                    Background="#1E88E5" Foreground="White" BorderThickness="0" Cursor="Hand">
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Delete" Click="DeleteBtn_Click" Width="110" Height="34"
                            FontSize="14" Background="#2A3B55" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Back" Click="BackBtn_Click" Width="110" Height="34"
                            Margin="10,0,0,0" FontSize="14" Background="#2A3B55" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,12,0,0"
                       FontSize="14" Foreground="#FFF0F0"/>

                <!-- ===== Круговой ввод пароля (КВП): циферблат ===== -->
                <StackPanel x:Name="CircularPanel" Orientation="Vertical" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Circlar dial: tap the sectors in your password sequence"
                               HorizontalAlignment="Center" FontSize="13" Foreground="#BFCBDC"/>
                    <Canvas x:Name="DialCanvas" Width="300" Height="300" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Background="Transparent"
                            MouseLeftButtonDown="DialCanvas_MouseLeftButtonDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="DialProgress" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"
                                   Text="Sequence: "/>
                        <Button Content="Clear" Click="DialClear_Click" Width="60" Height="28"
                                Margin="10,0,0,0" FontSize="12" Background="#2A3B55" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
        </StackPanel>

        <!-- ===== Активация (запрос ключа при первом запуске) ===== -->
        <StackPanel x:Name="ActivatePanel" Orientation="Vertical" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D1627">
            <TextBlock Text="Activate SEIW" FontFamily="Segoe UI" FontSize="28" FontWeight="Light"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Enter the license key to activate the program"
                       FontSize="14" Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>

            <TextBox x:Name="KeyBox" Width="320" Height="38" Margin="0,18,0,0" FontSize="15"
                     Padding="8,0,8,0" VerticalContentAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock x:Name="ActivateStatus" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                       HorizontalAlignment="Center" Text=""/>

            <Button Content="Activate" Click="ActivateBtn_Click" Width="200" Height="42"
                    HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="15"
                    Background="#1E88E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- ===== Мастер смены пароля (показывается при вводе ПВ-кода) ===== -->
        <StackPanel x:Name="ChangePassPanel" Orientation="Vertical" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D1627">
            <TextBlock Text="Change password" FontFamily="Segoe UI" FontSize="28" FontWeight="Light"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Set a new password to sign in" FontFamily="Segoe UI" FontSize="14"
                       Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>

            <TextBlock Text="New password" Foreground="#BFFFFFFF" Margin="0,18,0,0" FontSize="13"/>
            <TextBox x:Name="NewPassBox" Width="300" Height="38" Margin="0,4,0,0" FontSize="15"
                     Padding="8,0,8,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Confirm password" Foreground="#BFFFFFFF" Margin="0,10,0,0" FontSize="13"/>
            <TextBox x:Name="NewPassBox2" Width="300" Height="38" Margin="0,4,0,0" FontSize="15"
                     Padding="8,0,8,0" VerticalContentAlignment="Center"/>

            <TextBlock x:Name="ChangeStatusText" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                       HorizontalAlignment="Center" Text=""/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Apply password" Click="ApplyPass_Click" Width="180" Height="40"
                        FontSize="15" Background="#1E88E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Cancel" Click="CancelChange_Click" Width="100" Height="40"
                        Margin="10,0,0,0" FontSize="14" Background="#2A3B55" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>