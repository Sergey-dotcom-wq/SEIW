<Window x:Class="SEIW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEIW"
        mc:Ignorable="d"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowState="Maximized"
        Title="Parental Control SEIW" Background="Black">

    <Grid>
        <!-- Сменные обои (заполнение без влияния на раскладку) -->
        <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>

        <!-- Тонкая затемняющая подложка для читаемости -->
        <Grid Background="#A0000000"/>

        <!-- ================= ЭКРАН ВХОДА ================= -->
        <Grid x:Name="LoginRoot">

            <!-- Часы и дата: слева внизу -->
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="56,0,0,56">
                <TextBlock x:Name="ClockTime"
                           FontFamily="Segoe UI Light" FontSize="88" FontWeight="Light"
                           Foreground="White" Text="&#x2014;&#x2014;:&#x2014;&#x2014;"/>
                <TextBlock x:Name="ClockDate"
                           FontFamily="Segoe UI" FontSize="24" FontWeight="Light"
                           Foreground="#E6FFFFFF" Margin="6,4,0,0" Text=""/>
            </StackPanel>

            <!-- Индикатор раскладки клавиатуры: справа внизу (как в Windows) -->
            <TextBlock x:Name="KbdLayout" Text="ENG"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,56,56" FontFamily="Segoe UI" FontSize="12" FontWeight="Light"
                       Foreground="#E6FFFFFF"/>

            <!-- Центральный блок входа -->
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border Width="80" Height="80" CornerRadius="40" Background="#335A819A"
                        HorizontalAlignment="Center" BorderBrush="#66FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="AvatarLetter" FontFamily="Segoe UI" FontSize="38"
                               Foreground="White" Text="U"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="UserNameLabel" HorizontalAlignment="Center" Margin="0,14,0,0"
                           FontFamily="Segoe UI" FontSize="30" FontWeight="Light"
                           Foreground="White" Text="User"/>

                <Border Background="#22000000" CornerRadius="3" BorderBrush="#55FFFFFF"
                        BorderThickness="1" Margin="0,22,0,0" Width="360" Height="30">
                    <Grid>
                        <TextBox x:Name="PasswordBox"
                                 PreviewTextInput="PasswordBox_PreviewTextInput"
                                 PreviewKeyDown="PasswordBox_PreviewKeyDown"
                                 Padding="10,0,44,0" VerticalContentAlignment="Center"
                                 FontFamily="Segoe UI" FontSize="16"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 CaretBrush="White" IsTabStop="True"/>
                        <Button x:Name="ShowPasswordBtn" Content="&#x1F441;" Width="24" Height="24"
                                HorizontalAlignment="Right" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0" Foreground="#CCFFFFFF"
                                FontSize="13" Cursor="Hand" Click="ShowPasswordBtn_Click"/>
                    </Grid>
                </Border>

                <Button x:Name="EnterBtn" Content="Sign in" Click="EnterBtn_Click"
                        HorizontalAlignment="Center" Margin="0,18,0,0"
                        Width="180" Height="44" FontFamily="Segoe UI" FontSize="18" FontWeight="Light"
                        Background="#335A819A" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <Button x:Name="ForgotPassBtn" Content="Forgot password?"
                        HorizontalAlignment="Center" Margin="0,10,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#9FC7E8"
                        FontFamily="Segoe UI" FontSize="13" Cursor="Hand" Click="ForgotPassBtn_Click"/>

                <Button x:Name="ScheduleBtn" Content="Access schedule"
                        HorizontalAlignment="Center" Margin="0,6,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#9FC7E8"
                        FontFamily="Segoe UI" FontSize="13" Cursor="Hand" Click="ScheduleBtn_Click"/>

                <Button x:Name="KcidBtn" Content="Access calendar (KCID)"
                        HorizontalAlignment="Center" Margin="0,4,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#9FC7E8"
                        FontFamily="Segoe UI" FontSize="13" Cursor="Hand" Click="KcidBtn_Click"/>

                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,12,0,0"
                           FontFamily="Segoe UI" FontSize="14" Foreground="#FFF0F0" Text=""/>
            </StackPanel>
        </Grid>

        <!-- ================= ВОССТАНОВЛЕНИЕ ПАРОЛЯ (как в Windows) ================= -->
        <Grid x:Name="RecoverRoot" Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Recover password" FontFamily="Segoe UI" FontSize="30" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center"/>

                <TextBlock Text="Enter recovery code" Foreground="#BFFFFFFF" Margin="0,22,0,0" FontSize="13"/>
                <TextBox x:Name="RecoveryBox" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="New password" Foreground="#BFFFFFFF" Margin="0,12,0,0" FontSize="13"/>
                <TextBox x:Name="RecoveryNewPass" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Confirm new password" Foreground="#BFFFFFFF" Margin="0,12,0,0" FontSize="13"/>
                <TextBox x:Name="RecoveryConfirmPass" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="RecoveryStatus" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                           HorizontalAlignment="Center" Text=""/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Change password" Click="RecoveryConfirm_Click"
                            Width="200" Height="44" FontSize="16" Background="#334CB69C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Cancel" Click="RecoveryCancel_Click"
                            Width="120" Height="44" Margin="12,0,0,0" FontSize="15"
                            Background="#335A819A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= ПЕРВЫЙ ВХОД: настройка пароля и кода восстановления ================= -->
        <Grid x:Name="SetupRoot" Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="First-time setup" FontFamily="Segoe UI" FontSize="30" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Protect this computer" FontFamily="Segoe UI" FontSize="15" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <TextBlock Text="New password (desktop access)" Foreground="#BFFFFFFF" Margin="0,24,0,0" FontSize="13"/>
                <TextBox x:Name="SetupPass" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Confirm password" Foreground="#BFFFFFFF" Margin="0,12,0,0" FontSize="13"/>
                <TextBox x:Name="SetupPass2" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Recovery code (if you forget the password)"
                           Foreground="#BFFFFFFF" Margin="0,12,0,0" FontSize="13"/>
                <TextBox x:Name="SetupCode" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="SetupStatus" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                           HorizontalAlignment="Center" Text=""/>

                <Button Content="Done — enable protection" Click="SetupConfirm_Click"
                        HorizontalAlignment="Center" Width="260" Height="44" Margin="0,18,0,0"
                        FontSize="16" Background="#334CB69C" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- ================= СМЕНА ПАРОЛЯ (как в Windows) ================= -->
        <Grid x:Name="ChangePassRoot" Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Change password" FontFamily="Segoe UI" FontSize="30" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Account: " FontFamily="Segoe UI" FontSize="16" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Run Text=""/><Run x:Name="ChangeUserRun" Text="" Foreground="White"/>
                </TextBlock>

                <TextBlock Text="Current password" Foreground="#BFFFFFFF" Margin="0,22,0,0" FontSize="13"/>
                <TextBox x:Name="CurPass" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="New password" Foreground="#BFFFFFFF" Margin="0,12,0,0" FontSize="13"/>
                <TextBox x:Name="NewPass" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Confirm new password" Foreground="#BFFFFFFF" Margin="0,12,0,0" FontSize="13"/>
                <TextBox x:Name="ConfirmPass" Width="300" Height="40" Margin="0,4,0,0" FontSize="15"
                         Padding="8,0,8,0" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="ChangeStatus" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                           HorizontalAlignment="Center" Text=""/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Change password" Click="ChangePassConfirm_Click"
                            Width="200" Height="44" FontSize="16" Background="#334CB69C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Cancel" Click="ChangePassCancel_Click"
                            Width="120" Height="44" Margin="12,0,0,0" FontSize="15"
                            Background="#335A819A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= НАСТРОЙКА РАСПИСАНИЯ ================= -->
        <Grid x:Name="ScheduleRoot" Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Access schedule" FontFamily="Segoe UI" FontSize="30" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Time limits by day" FontFamily="Segoe UI" FontSize="15"
                           Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <TextBlock Text="Day:" Foreground="#BFFFFFFF" VerticalAlignment="Center" FontSize="14"/>
                    <ComboBox x:Name="SchedDay" Width="120" Margin="8,0,0,0" Height="36" FontSize="14"/>
                    <TextBlock Text="From:" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14"/>
                    <TextBox x:Name="SchedStart" Width="70" Height="36" Margin="8,0,0,0" FontSize="14"
                             Text="09:00" TextAlignment="Center"/>
                    <TextBlock Text="to:" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14"/>
                    <TextBox x:Name="SchedEnd" Width="70" Height="36" Margin="8,0,0,0" FontSize="14"
                             Text="21:00" TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Action:" Foreground="#BFFFFFFF" VerticalAlignment="Center" FontSize="14"/>
                    <ComboBox x:Name="SchedAction" Width="200" Margin="8,0,0,0" Height="36" FontSize="14"/>
                    <Button Content="Add" Click="SchedAdd_Click" Width="120" Height="36"
                            Margin="12,0,0,0" Background="#334CB69C" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="14"/>
                </StackPanel>

                <ListBox x:Name="SchedList" Width="520" Height="180" Margin="0,16,0,0"
                         FontSize="14" Background="#0f1a2b" Foreground="White"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Remove selected" Click="SchedRemove_Click" Width="180" Height="40"
                            Background="#FF6B6B" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                    <Button Content="Done" Click="SchedDone_Click" Width="120" Height="40"
                            Margin="12,0,0,0" Background="#335A819A" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="14"/>
                </StackPanel>

                <TextBlock x:Name="SchedStatus" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                           HorizontalAlignment="Center" Text=""/>
            </StackPanel>
        </Grid>

        <!-- ================= КЧИД: календарно-часовой интерфейс доступа ================= -->
        <Grid x:Name="KcidRoot" Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Access calendar (KCID)" FontFamily="Segoe UI" FontSize="28" FontWeight="Light"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Colour cells where access is allowed (click to toggle)"
                           FontFamily="Segoe UI" FontSize="13" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <!-- Сетка: столбец слева = часы, далее 7 дней (Пн..Вс). Рисуется кодом в constructGrid -->
                <Border Background="#101b2e" BorderBrush="#2b4060" BorderThickness="1" Margin="0,16,0,0"
                        HorizontalAlignment="Center">
                    <Grid x:Name="KcidGrid"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Clear all" Click="KcidClear_Click" Width="130" Height="38"
                            Background="#FF6B6B" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                    <Button Content="Save" Click="KcidSave_Click" Width="130" Height="38"
                            Margin="12,0,0,0" Background="#1E88E5" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="14"/>
                    <Button Content="Cancel" Click="KcidCancel_Click" Width="110" Height="38"
                            Margin="12,0,0,0" Background="#2A3B55" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="14"/>
                </StackPanel>

                <TextBlock x:Name="KcidStatus" Foreground="#FFF0F0" Margin="0,10,0,0" FontSize="14"
                           HorizontalAlignment="Center" Text=""/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>